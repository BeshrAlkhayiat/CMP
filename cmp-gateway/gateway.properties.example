# CMP Gateway Configuration
# Copy this file to gateway.properties and customize for your environment

# REST API Configuration
rest.baseUrl=https://localhost:5443/cema/ccm/svc/db.file/rest/v2
ca.name=TEST_CA
template.name=DEFAULT_TEMPLATE
lookup.name=default

# Authentication Configuration
# Options: certificate or basic
auth.type=certificate

# For basic authentication
auth.username=admin
auth.login.user=TenantAdmin
auth.password=changeit

# For certificate authentication (PKCS#12 format)
auth.keystore.path=/path/to/client-cert.p12
auth.keystore.password=changeit
auth.keystore.alias=client

# Truststore for CMP protection validation is OPTIONAL: by default the gateway
# fetches the CA chain automatically from CEMA via GET /ca/{caName}/chain.
# Only set auth.truststore.path if you want to pin trust anchors in a file
# (PKCS12/JKS containing the CA certificate(s) with CA:TRUE, no private keys);
# it is used as fallback when the automatic fetch fails.
auth.truststore.path=
auth.truststore.password=
auth.truststore.type=PKCS12

# CMP Protection Secret (text format, used for MAC-based protection)
cmp.protection.secret=gateway-secret-key

# CMP listener
cmp.server.port=9000
cmp.server.path=/cmp

# Central key generation defaults for CRMF requests without a subject public key
central.key.kind=RSA
central.key.size=2048
# central.key.curve=secp256r1

# Timing Configuration
retry.after.seconds=30
downstream.timeout.seconds=300

# CRMF (initReq/certReq/keyUpdateReq) handling. The CEMA REST API currently
# supports CSR (PKCS#10) enrollment only, so this defaults to false: CRMF requests
# are rejected with a readable CMP error instead of being forwarded to CEMA.
# Set to true once the backend can process CRMF.
crm.enabled=false
